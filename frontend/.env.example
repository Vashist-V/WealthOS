# Leave the Supabase values blank to run in demo-workspace mode only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Where the API is. In development it is on its own port. Leave it out of a
# production build that the API itself serves: the app then uses its own address.
VITE_API_URL=http://localhost:8000

# Supabase — leave blank to run in demo-workspace mode only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. Lets the backend persist shared market data (price_history, dividends,
# corporate_actions) into Supabase. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_ENABLED=true

# Deployment only (the Dockerfile sets WEB_DIR). Point WEB_DIR at the built
# frontend and this one service answers for the web app as well as the API.
WEB_DIR=
# The address people reach the deployed app at, e.g. https://wealthos.example.com.
# Link previews need it to find the share picture. Render fills it in by itself.
PUBLIC_URL=
# A free host switches the server off after 15 quiet minutes, and the next
# visitor waits a minute. With the address above known, the server visits
# itself this often to stay up. 0 turns it off.
KEEP_AWAKE_MINUTES=5

RISK_FREE_RATE=0.065
BENCHMARK=^NSEI

# Stock assistant. Add one key to turn on AI answers; without any, the
# assistant answers the suggested questions from the app's own data.
# auto = the free services you have keys for (Gemini first, then LLM_API_KEY's),
# each taking over when the other is out of quota; Claude only if it is the only key.
# Or name them, in the order to try: gemini | groq | anthropic | groq,gemini
ASSISTANT_PROVIDER=auto
# Lets the assistant search the web for recent news.
ASSISTANT_WEB_SEARCH=true

# Google Gemini (has a free tier: https://aistudio.google.com/apikey).
# Several keys can be given, separated by commas; each is tried in turn. Keys
# from the same Google project share one allowance, so only keys from
# different projects add anything.
GEMINI_API_KEY=
ASSISTANT_GEMINI_MODEL=gemini-2.5-flash
# The free plan gives each model its own small daily allowance, so these are
# stepped through, in order, when the model above is used up or busy.
ASSISTANT_GEMINI_FALLBACK=gemini-flash-latest,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite

# A second free service, asked when Gemini's free quota is used up, or on its
# own. Groq by default (free key, no card: https://console.groq.com/keys).
# GROQ_API_KEY works as a name for the key too. Several keys can be given,
# separated by commas, but keys from one Groq account share one allowance.
LLM_API_KEY=
# Any service that speaks the OpenAI chat API works: change the address and
# the model, e.g. https://api.cerebras.ai/v1 or https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Anthropic Claude (paid; web search is billed per search)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# low | medium | high: how much reasoning each answer gets.
ASSISTANT_EFFORT=medium

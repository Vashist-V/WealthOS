# Supabase — leave blank to run in demo-workspace mode only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. Lets the backend persist shared market data (price_history, dividends,
# corporate_actions) into Supabase. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_ENABLED=true

# Deployment only (the Dockerfile sets WEB_DIR). Point WEB_DIR at the built
# frontend and this one service answers for the web app as well as the API.
WEB_DIR=
# The address people reach the deployed app at, e.g. https://wealthos.example.com.
# Link previews need it to find the share picture. Render fills it in by itself.
PUBLIC_URL=

RISK_FREE_RATE=0.065
BENCHMARK=^NSEI

# Stock assistant. Add one key to turn on AI answers; without any, the
# assistant answers the suggested questions from the app's own data.
# auto = Gemini when GEMINI_API_KEY is set, otherwise Claude. Or force: gemini | anthropic
ASSISTANT_PROVIDER=auto
# Lets the assistant search the web for recent news.
ASSISTANT_WEB_SEARCH=true

# Google Gemini (has a free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
ASSISTANT_GEMINI_MODEL=gemini-2.5-flash
# Used if the model above is out of quota or unavailable.
ASSISTANT_GEMINI_FALLBACK=gemini-3.5-flash

# Anthropic Claude (paid; web search is billed per search)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# low | medium | high: how much reasoning each answer gets.
ASSISTANT_EFFORT=medium
